rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "Phon96.UTC@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }
    
    function isChairman() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'chairman'
      );
    }

    function isAssigned(data) {
      return isSignedIn() && (
        (request.auth.uid in data.assigneeIds || data.assignedBy == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('username', 'DEFAULT_NULL') in data.assigneeIds || 
          data.assignedBy == getUserData().get('username', 'DEFAULT_NULL') ||
          getUserData().get('email', 'DEFAULT_NULL') in data.assigneeIds || 
          data.assignedBy == getUserData().get('email', 'DEFAULT_NULL')
        ))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true; 
      allow write: if true;
    }
    
    match /tasks/{taskId} {
      allow read, create, update, delete: if true;
    }
    
    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    // Luôn cho phép đường dẫn test kết nối
    match /test/connection {
      allow read: if true;
    }
    
    // Chặn tất cả các trường hợp khác
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
